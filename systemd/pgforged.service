[Unit]
Description=ForgeBase control plane
After=docker.service network-online.target
Requires=docker.service

[Service]
ExecStart=/opt/pgforge/bin/pgforged
EnvironmentFile=/opt/pgforge/pgforged.env
Restart=always
# Bounds the whole control-plane cgroup INCLUDING its PostgREST and Deno
# children - one runaway function cannot take the host down. Breaching the hard
# cap kills pgforged; systemd restarts it in ~2s.
MemoryHigh=1G
MemoryMax=1536M
RestartSec=2

[Install]
WantedBy=multi-user.target
