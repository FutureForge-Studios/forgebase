# Copy to .env and fill in. .env is gitignored - never commit secrets.

# Server SSH (used by deploy.sh / tools/rr.py / tools/put.py / tools/get.py)
SERVER_IP=
SERVER_USER=root
SERVER_PASS=

# Domain served by Caddy. DNS: DOMAIN, db.DOMAIN and *.DOMAIN -> SERVER_IP
DOMAIN=
ACME_EMAIL=

# Panel login (also the pgweb SQL editor login)
PANEL_USER=admin
PANEL_PASS=

# Postgres superuser password (printed by install.sh; kept in
# /opt/pgforge/pgforged.env on the server)
POSTGRES_PASSWORD=
