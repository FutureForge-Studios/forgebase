# ForgeBase Caddy config. __DOMAIN__ and __ACME_EMAIL__ are substituted by
# install.sh. Certificates are issued on demand: Caddy asks pgforged
# (/internal/tls-check) whether a hostname is legit before requesting a cert,
# so new projects get HTTPS with zero config edits.
{
	email __ACME_EMAIL__
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/tls-check
	}
}

# The control plane (pgforged) restarts itself during a self-update, leaving its
# port unbound for ~1-3s. lb_try_duration makes Caddy retry the upstream for a
# few seconds instead of returning an immediate 502, so a request that lands in
# that restart window waits and succeeds once pgforged is back up.
__DOMAIN__ {
	reverse_proxy 127.0.0.1:8080 {
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}

db.__DOMAIN__ {
	reverse_proxy 127.0.0.1:8081
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8080 {
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}
